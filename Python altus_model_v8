# ---------------- HELPERS ----------------
def extra_metrics(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    mae  = mean_absolute_error(y_true, y_pred)
    rmse = sqrt(mean_squared_error(y_true, y_pred))
    r2   = r2_score(y_true, y_pred)
    return {"MAE": mae, "RMSE": rmse, "R2": r2}

def flood_focus_metrics(y_true, y_pred, flood_threshold=None, event_threshold=None):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    out = {}

    if flood_threshold is not None:
        flood_mask = y_true >= float(flood_threshold)
        out['FloodThreshold'] = float(flood_threshold)
        out['FloodN'] = int(flood_mask.sum())
        if flood_mask.sum() > 0:
            out['FloodMAE'] = float(mean_absolute_error(y_true[flood_mask], y_pred[flood_mask]))
            out['FloodRMSE'] = float(sqrt(mean_squared_error(y_true[flood_mask], y_pred[flood_mask])))
        else:
            out['FloodMAE'] = np.nan
            out['FloodRMSE'] = np.nan

    if event_threshold is not None:
        event_true = y_true >= float(event_threshold)
        event_pred = y_pred >= float(event_threshold)
        tp = int(np.sum(event_true & event_pred))
        fn = int(np.sum(event_true & (~event_pred)))
        fp = int(np.sum((~event_true) & event_pred))
        out['EventThreshold'] = float(event_threshold)
        out['EventN'] = int(event_true.sum())
        out['EventRecall'] = float(tp / (tp + fn)) if (tp + fn) > 0 else np.nan
        out['EventPrecision'] = float(tp / (tp + fp)) if (tp + fp) > 0 else np.nan

    return out

def eval_model_log(name, model, X_i, y_true_raw, flood_threshold=None, event_threshold=None):
    """Models trained on log1p(target); evaluate on original scale."""
    if flood_threshold is None and 'flood_threshold_train' in globals():
        flood_threshold = globals().get('flood_threshold_train')
    if event_threshold is None and 'event_threshold_train' in globals():
        event_threshold = globals().get('event_threshold_train')

    pred_log = model.predict(X_i)
    pred_raw = np.expm1(pred_log)
    res = extra_metrics(y_true_raw, pred_raw)
    res.update(flood_focus_metrics(y_true_raw, pred_raw, flood_threshold=flood_threshold, event_threshold=event_threshold))
    res['name'] = name
    return res, pred_raw

def eval_model(name, model, X_i, y_true_raw, flood_threshold=None, event_threshold=None):
    pred_raw = model.predict(X_i)
    res = extra_metrics(y_true_raw, pred_raw)
    res.update(flood_focus_metrics(y_true_raw, pred_raw, flood_threshold=flood_threshold, event_threshold=event_threshold))
    res['name'] = name
    return res, pred_raw

def safe_filename(s):
    return ''.join(ch if ch.isalnum() or ch in ('-', '_') else '_' for ch in str(s))


def normalize_validation_mode(mode):
    mode_key = str(mode).strip().lower()
    aliases = {
        'random_days_diagnostic': 'random_days',
        'random_day_diagnostic': 'random_days',
        'random_days': 'random_days',
        'year_grouped': 'year_grouped',
        'grouped_year': 'year_grouped',
        'chronological': 'chronological',
        'time': 'chronological',
    }
    if mode_key not in aliases:
        raise ValueError(
            f"Unknown VALIDATION_MODE='{mode}'. "
            "Use 'chronological', 'year_grouped', or 'random_days_diagnostic'."
        )
    return aliases[mode_key]


def assign_validation_splits(df):
    split_df = df[['date_day', 'year']].copy()
    split_df['date_day'] = pd.to_datetime(split_df['date_day'])
    split_df['year'] = split_df['year'].astype(int)

    mode = normalize_validation_mode(VALIDATION_MODE)
    years = split_df['year']
    dates = split_df['date_day']
    labels = pd.Series('unused', index=split_df.index, dtype='object')

    pretrain_mask = years < TRAIN_START
    test_mask = years > VAL_END
    dev_mask = (years >= TRAIN_START) & (years <= VAL_END)
    labels.loc[pretrain_mask] = 'pretrain_excluded'
    labels.loc[test_mask] = 'test'

    meta = {
        'validation_mode': mode,
        'train_start': TRAIN_START,
        'train_end': TRAIN_END,
        'val_end': VAL_END,
        'validation_random_state': VALIDATION_RANDOM_STATE,
        'validation_purge_days': VALIDATION_PURGE_DAYS,
    }

    if not dev_mask.any():
        raise ValueError("No rows found between TRAIN_START and VAL_END.")

    if mode == 'chronological':
        train_mask = dev_mask & (years <= TRAIN_END)
        val_mask = dev_mask & (years > TRAIN_END)
        labels.loc[train_mask] = 'train'
        labels.loc[val_mask] = 'val'
        meta.update({
            'validation_description': f'chronological val years {TRAIN_END + 1}-{VAL_END}',
            'validation_years': ','.join(str(y) for y in range(TRAIN_END + 1, VAL_END + 1)),
        })

    elif mode == 'year_grouped':
        eligible_years = np.array(sorted(years.loc[dev_mask].unique()), dtype=int)
        if len(eligible_years) <= 1:
            raise ValueError("Need at least two years between TRAIN_START and VAL_END for year_grouped validation.")

        if VALIDATION_YEARS is None:
            n_val_years = max(1, int(round(len(eligible_years) * float(VALIDATION_YEAR_FRACTION))))
            n_val_years = min(n_val_years, len(eligible_years) - 1)
            rng = np.random.default_rng(VALIDATION_RANDOM_STATE)
            val_years = sorted(rng.choice(eligible_years, size=n_val_years, replace=False).astype(int).tolist())
        else:
            val_years = sorted({int(y) for y in VALIDATION_YEARS})
            invalid_years = [y for y in val_years if y not in set(eligible_years)]
            if invalid_years:
                raise ValueError(
                    f"VALIDATION_YEARS contains years outside TRAIN_START..VAL_END: {invalid_years}"
                )

        val_mask = dev_mask & years.isin(val_years)
        train_mask = dev_mask & ~val_mask

        if VALIDATION_PURGE_DAYS > 0:
            purge_delta = pd.Timedelta(days=int(VALIDATION_PURGE_DAYS))
            purge_mask = pd.Series(False, index=split_df.index)
            for y in val_years:
                val_start = pd.Timestamp(year=int(y), month=1, day=1)
                val_end = pd.Timestamp(year=int(y), month=12, day=31)
                purge_mask = purge_mask | (train_mask & dates.between(val_start - purge_delta, val_end + purge_delta))
            labels.loc[purge_mask] = 'purged_from_training'
            train_mask = train_mask & ~purge_mask

        labels.loc[train_mask] = 'train'
        labels.loc[val_mask] = 'val'
        meta.update({
            'validation_description': 'randomly held-out whole validation years',
            'validation_years': ','.join(str(y) for y in val_years),
            'validation_year_fraction': VALIDATION_YEAR_FRACTION,
        })

    elif mode == 'random_days':
        dev_index = split_df.index[dev_mask].to_numpy()
        n_val = max(1, int(round(len(dev_index) * float(VALIDATION_RANDOM_DAY_FRACTION))))
        n_val = min(n_val, len(dev_index) - 1)
        rng = np.random.default_rng(VALIDATION_RANDOM_STATE)
        val_index = rng.choice(dev_index, size=n_val, replace=False)
        labels.loc[dev_mask] = 'train'
        labels.loc[val_index] = 'val'
        meta.update({
            'validation_description': 'randomly held-out days; diagnostic only because nearby target windows overlap',
            'validation_years': 'mixed_days',
            'validation_random_day_fraction': VALIDATION_RANDOM_DAY_FRACTION,
        })
        print(
            "Warning: random_days_diagnostic mixes nearby days across train/val. "
            "Use it as a diagnostic, not as the final future-performance estimate."
        )

    if (labels == 'train').sum() == 0:
        raise ValueError("Validation split produced zero training rows.")
    if (labels == 'val').sum() == 0:
        raise ValueError("Validation split produced zero validation rows.")

    return labels, meta


def save_split_summary(df, split_meta, out_dir=OUT_DIR):
    rows = []
    for split_name, g in df.groupby('split', dropna=False):
        rows.append({
            'split': split_name,
            'rows': int(len(g)),
            'start_date': g['date_day'].min(),
            'end_date': g['date_day'].max(),
            'min_year': int(g['year'].min()) if len(g) else np.nan,
            'max_year': int(g['year'].max()) if len(g) else np.nan,
            'year_count': int(g['year'].nunique()) if len(g) else 0,
        })
    summary = pd.DataFrame(rows).sort_values('split')
    for key, value in split_meta.items():
        summary[key] = value

    out_csv = out_dir / 'validation_split_summary.csv'
    summary.to_csv(out_csv, index=False)
    print(f"Saved: {out_csv}")
    print("\n=== VALIDATION SPLIT SUMMARY ===")
    print(summary[['split', 'rows', 'start_date', 'end_date', 'year_count']])
    print(f"Validation mode: {split_meta.get('validation_mode')} ({split_meta.get('validation_description')})")
    return summary


def shade_split_spans(ax, split_df):
    styles = {
        'pretrain_excluded': ('0.5', 0.08, f'Pretrain excluded (< {TRAIN_START})'),
        'train': ('tab:green', 0.10, 'Train'),
        'val': ('tab:orange', 0.10, 'Val'),
        'test': ('tab:blue', 0.08, f'Test (> {VAL_END})'),
        'purged_from_training': ('0.5', 0.06, 'Purged from training'),
    }
    mode = normalize_validation_mode(VALIDATION_MODE)
    allowed_splits = set(styles)
    if mode == 'random_days':
        allowed_splits = {'pretrain_excluded', 'test'}

    x = (
        split_df[['date_day', 'split']]
        .dropna(subset=['date_day', 'split'])
        .sort_values('date_day')
    )
    x = x[x['split'].isin(allowed_splits)]
    if x.empty:
        return []

    handles = []
    seen = set()
    group_id = x['split'].ne(x['split'].shift()).cumsum()
    for _, g in x.groupby(group_id):
        split_name = g['split'].iloc[0]
        color, alpha, label = styles[split_name]
        ax.axvspan(g['date_day'].iloc[0], g['date_day'].iloc[-1] + pd.Timedelta(days=1), color=color, alpha=alpha, zorder=0)
        if split_name not in seen:
            handles.append(Patch(facecolor=color, alpha=alpha, label=label))
            seen.add(split_name)
    return handles


def build_tuning_candidates(default_params, fixed_grid, param_distributions, n_iter, random_state, mode):
    mode_key = str(mode).strip().lower()
    candidates = [dict(default_params)]

    if mode_key == 'fixed_grid':
        candidates.extend(dict(p) for p in fixed_grid)
    elif mode_key == 'random':
        sampled = ParameterSampler(param_distributions, n_iter=int(n_iter), random_state=int(random_state))
        for params in sampled:
            candidate = dict(default_params)
            candidate.update(dict(params))
            candidates.append(candidate)
    else:
        raise ValueError(f"Unknown TUNING_MODE='{mode}'. Use 'random' or 'fixed_grid'.")

    unique = []
    seen = set()
    for params in candidates:
        key = tuple(sorted((k, str(v)) for k, v in params.items()))
        if key not in seen:
            unique.append(params)
            seen.add(key)
    return unique


def build_baseline_predictions(train_df, eval_df):
    train_target = train_df['inflow_next30'].astype(float)
    train_mean = float(train_target.mean())
    train_median = float(train_target.median())
    monthly_median = train_df.groupby(train_df['date_day'].dt.month)['inflow_next30'].median()

    n = len(eval_df)
    preds = {
        'Baseline_TrainMean_DailyNext30': np.full(n, train_mean, dtype=float),
        'Baseline_TrainMedian_DailyNext30': np.full(n, train_median, dtype=float),
        'Baseline_MonthlyTrainMedian_DailyNext30': (
            eval_df['date_day']
            .dt.month
            .map(monthly_median)
            .fillna(train_median)
            .to_numpy(dtype=float)
        ),
    }

    if 'qin_30d' in eval_df.columns:
        preds['Baseline_PersistenceQin30_DailyNext30'] = eval_df['qin_30d'].to_numpy(dtype=float)
    if 'qin_90d' in eval_df.columns:
        preds['Baseline_PersistenceQin90Div3_DailyNext30'] = (eval_df['qin_90d'] / 3.0).to_numpy(dtype=float)
    if 'qin_180d' in eval_df.columns:
        preds['Baseline_PersistenceQin180Div6_DailyNext30'] = (eval_df['qin_180d'] / 6.0).to_numpy(dtype=float)
    if 'qin_365d' in eval_df.columns:
        preds['Baseline_PersistenceQin365Scaled_DailyNext30'] = (eval_df['qin_365d'] * (30.0 / 365.0)).to_numpy(dtype=float)

    return preds


def evaluate_baselines(train_df, split_frames, flood_threshold, event_threshold, out_dir=OUT_DIR):
    rows = []
    for split_name, split_df in split_frames.items():
        y_true = split_df['inflow_next30'].to_numpy(dtype=float)
        for baseline_name, y_pred in build_baseline_predictions(train_df, split_df).items():
            m = extra_metrics(y_true, y_pred)
            m.update(flood_focus_metrics(
                y_true,
                y_pred,
                flood_threshold=flood_threshold,
                event_threshold=event_threshold,
            ))
            m['split'] = split_name
            m['name'] = baseline_name
            m['kind'] = 'baseline'
            rows.append(m)

    baseline_df = pd.DataFrame(rows).sort_values(['split', 'MAE', 'name'])
    out_csv = out_dir / 'metrics_baselines_daily_next30.csv'
    baseline_df.to_csv(out_csv, index=False)
    print(f"Saved: {out_csv}")
    print("\n=== DAILY NEXT-30D BASELINE METRICS (lower is better) ===")
    print(baseline_df)
    return baseline_df


def feature_importance_df(model_name, model, feature_names):
    if hasattr(model, 'feature_importances_'):
        values = np.asarray(model.feature_importances_, dtype=float)
        importance_kind = 'feature_importances_'
    elif hasattr(model, 'coef_'):
        values = np.abs(np.asarray(model.coef_, dtype=float).ravel())
        importance_kind = 'abs_coef_log_target'
    else:
        return None

    if len(values) != len(feature_names):
        print(
            f"Skipping feature importance for {model_name}: "
            f"{len(values)} values for {len(feature_names)} features."
        )
        return None

    out = pd.DataFrame({
        'model': model_name,
        'feature': feature_names,
        'importance': values,
        'importance_kind': importance_kind,
    }).sort_values('importance', ascending=False).reset_index(drop=True)
    out['rank'] = np.arange(1, len(out) + 1)
    return out


