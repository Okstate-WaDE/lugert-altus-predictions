def tune_log_target_regressor(
    model_name,
    model_factory,
    param_candidates,
    X_tr_i,
    y_tr_log,
    y_tr_raw,
    X_v_i,
    y_v_raw,
    selection_metric='MAE',
    gap_penalty=0.25,
    out_dir=OUT_DIR,
):
    rows = []
    if len(param_candidates) == 0:
        raise ValueError(f"No hyperparameter candidates provided for {model_name}.")

    print(f"\n=== {model_name} HYPERPARAMETER TUNING ===")
    print(f"Testing {len(param_candidates)} candidates using TUNING_MODE='{TUNING_MODE}'.")
    for candidate_id, params in enumerate(param_candidates, start=1):
        model = model_factory(params)
        model.fit(X_tr_i, y_tr_log)

        train_metrics, _ = eval_model_log(f'{model_name}_candidate_{candidate_id}', model, X_tr_i, y_tr_raw)
        val_metrics, _ = eval_model_log(f'{model_name}_candidate_{candidate_id}', model, X_v_i, y_v_raw)

        row = {'model': model_name, 'candidate': candidate_id}
        row.update(params)
        for key, value in train_metrics.items():
            if key != 'name':
                row[f'train_{key}'] = value
        for key, value in val_metrics.items():
            if key != 'name':
                row[f'val_{key}'] = value
        rows.append(row)

    tuning_df = pd.DataFrame(rows)
    metric_candidates = [selection_metric, 'MAE', 'RMSE']
    selected_metric = None
    for metric in metric_candidates:
        col = f'val_{metric}'
        if col in tuning_df.columns and tuning_df[col].notna().any():
            selected_metric = metric
            break
    if selected_metric is None:
        raise ValueError(f"No usable validation metric found for tuning {model_name}.")

    val_col = f'val_{selected_metric}'
    train_col = f'train_{selected_metric}'
    gap_col = f'gap_{selected_metric}'
    tuning_score_col = f'tuning_score_{selected_metric}'

    if train_col in tuning_df.columns:
        tuning_df[gap_col] = tuning_df[val_col] - tuning_df[train_col]
        tuning_df[tuning_score_col] = tuning_df[val_col] + float(gap_penalty) * tuning_df[gap_col].clip(lower=0.0)
    else:
        tuning_df[gap_col] = np.nan
        tuning_df[tuning_score_col] = tuning_df[val_col]

    sort_cols = [tuning_score_col, val_col]
    for col in ['val_MAE', 'val_RMSE']:
        if col in tuning_df.columns and col not in sort_cols:
            sort_cols.append(col)

    ranked = tuning_df.sort_values(sort_cols).reset_index(drop=True)
    ranked['tuning_rank'] = np.arange(1, len(ranked) + 1)
    out_csv = out_dir / f'hyperparameter_tuning_{safe_filename(model_name)}.csv'
    ranked.to_csv(out_csv, index=False)
    print(f"Saved: {out_csv}")

    best = ranked.iloc[0]
    best_params = dict(param_candidates[int(best['candidate']) - 1])

    print(
        f"Selected {model_name} params by {tuning_score_col} "
        f"(val_{selected_metric} plus {gap_penalty:.2f}x positive train/val gap):"
    )
    print(pd.DataFrame([best[['candidate'] + sort_cols + list(param_candidates[0].keys())]]).to_string(index=False))
    return best_params, ranked


