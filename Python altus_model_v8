def build_environment_change_diagnostics(daily_df, event_threshold, flood_threshold, out_dir=OUT_DIR):
    env_cols = ['date_day', 'year', COL_INFLOW, 'inflow_next30']
    if 'split' in daily_df.columns:
        env_cols.append('split')
    env = daily_df[env_cols].copy()
    env['daily_inflow'] = pd.to_numeric(env[COL_INFLOW], errors='coerce')
    env['inflow_next30'] = pd.to_numeric(env['inflow_next30'], errors='coerce')
    env = env.dropna(subset=['date_day', 'year', 'daily_inflow', 'inflow_next30'])
    env['year'] = env['year'].astype(int)
    env['event_day'] = env['inflow_next30'] >= float(event_threshold)
    env['flood_day'] = env['inflow_next30'] >= float(flood_threshold)

    if env.empty:
        print("Skipping environmental change diagnostics: no complete rows.")
        return pd.DataFrame()

    annual = (
        env.groupby('year')
        .agg(
            n_days=('inflow_next30', 'size'),
            daily_inflow_mean=('daily_inflow', 'mean'),
            daily_inflow_std=('daily_inflow', 'std'),
            daily_inflow_q25=('daily_inflow', lambda s: s.quantile(0.25)),
            daily_inflow_median=('daily_inflow', 'median'),
            daily_inflow_q75=('daily_inflow', lambda s: s.quantile(0.75)),
            daily_inflow_q90=('daily_inflow', lambda s: s.quantile(0.90)),
            inflow_next30_mean=('inflow_next30', 'mean'),
            inflow_next30_std=('inflow_next30', 'std'),
            inflow_next30_q25=('inflow_next30', lambda s: s.quantile(0.25)),
            inflow_next30_median=('inflow_next30', 'median'),
            inflow_next30_q75=('inflow_next30', lambda s: s.quantile(0.75)),
            inflow_next30_q90=('inflow_next30', lambda s: s.quantile(0.90)),
            event_days=('event_day', 'sum'),
            flood_days=('flood_day', 'sum'),
        )
        .reset_index()
        .sort_values('year')
    )
    annual['daily_inflow_iqr'] = annual['daily_inflow_q75'] - annual['daily_inflow_q25']
    annual['inflow_next30_iqr'] = annual['inflow_next30_q75'] - annual['inflow_next30_q25']
    annual['event_rate'] = annual['event_days'] / annual['n_days']
    annual['flood_rate'] = annual['flood_days'] / annual['n_days']
    annual['event_threshold_train'] = float(event_threshold)
    annual['flood_threshold_train'] = float(flood_threshold)
    if 'split' in env.columns:
        split_counts = (
            env.groupby(['year', 'split'])
            .size()
            .rename('split_days')
            .reset_index()
            .sort_values(['year', 'split_days'], ascending=[True, False])
        )
        annual_split = split_counts.drop_duplicates('year')[['year', 'split']]
        annual = annual.merge(annual_split.rename(columns={'split': 'dominant_split'}), on='year', how='left')

    rolling_cols = [
        'daily_inflow_std',
        'daily_inflow_iqr',
        'inflow_next30_std',
        'inflow_next30_iqr',
        'inflow_next30_q90',
        'event_rate',
        'flood_rate',
    ]
    for col in rolling_cols:
        annual[f'{col}_roll3'] = annual[col].rolling(3, min_periods=1).mean()

    out_csv = out_dir / 'environment_change_annual_diagnostics.csv'
    annual.to_csv(out_csv, index=False)
    print(f"Saved: {out_csv}")

    def shade_splits(ax):
        ymin, ymax = annual['year'].min() - 0.5, annual['year'].max() + 0.5
        mode = normalize_validation_mode(VALIDATION_MODE)
        if mode == 'chronological' or 'dominant_split' not in annual.columns:
            if ymin < TRAIN_START - 0.5:
                ax.axvspan(ymin, TRAIN_START - 0.5, color='0.5', alpha=0.08, zorder=0)
            ax.axvspan(TRAIN_START - 0.5, TRAIN_END + 0.5, color='tab:green', alpha=0.08, zorder=0)
            ax.axvspan(TRAIN_END + 0.5, VAL_END + 0.5, color='tab:orange', alpha=0.08, zorder=0)
            ax.axvspan(VAL_END + 0.5, ymax, color='tab:blue', alpha=0.06, zorder=0)
            return

        styles = {
            'pretrain_excluded': ('0.5', 0.08),
            'train': ('tab:green', 0.08),
            'val': ('tab:orange', 0.08),
            'test': ('tab:blue', 0.06),
            'purged_from_training': ('0.5', 0.06),
        }
        annual_shades = annual[['year', 'dominant_split']].dropna().sort_values('year')
        group_id = annual_shades['dominant_split'].ne(annual_shades['dominant_split'].shift()).cumsum()
        for _, g in annual_shades.groupby(group_id):
            split_name = g['dominant_split'].iloc[0]
            if split_name not in styles:
                continue
            color, alpha = styles[split_name]
            ax.axvspan(g['year'].min() - 0.5, g['year'].max() + 0.5, color=color, alpha=alpha, zorder=0)

    fig, axes = plt.subplots(3, 1, figsize=(12, 11), sharex=True)
    years = annual['year']

    shade_splits(axes[0])
    axes[0].plot(years, annual['inflow_next30_iqr'], marker='o', linewidth=1.2, label='Annual IQR')
    axes[0].plot(years, annual['inflow_next30_iqr_roll3'], linewidth=2.2, label='3-year rolling IQR')
    axes[0].plot(years, annual['inflow_next30_std_roll3'], linewidth=1.8, linestyle='--', label='3-year rolling std')
    axes[0].set_ylabel('Next-30 inflow spread')
    axes[0].set_title('Environmental Change Diagnostics: Inflow Volatility and High-Flow Frequency')
    axes[0].grid(True, alpha=0.35)
    axes[0].legend(fontsize='small', loc='upper right')

    shade_splits(axes[1])
    axes[1].plot(years, annual['event_rate'] * 100.0, marker='o', linewidth=1.2, label=f'Event rate >= {event_threshold:.0f}')
    axes[1].plot(years, annual['event_rate_roll3'] * 100.0, linewidth=2.2, label='3-year rolling event rate')
    axes[1].plot(years, annual['flood_rate_roll3'] * 100.0, linewidth=1.8, linestyle='--', label=f'3-year flood rate >= {flood_threshold:.0f}')
    axes[1].set_ylabel('Days per year (%)')
    axes[1].grid(True, alpha=0.35)
    axes[1].legend(fontsize='small', loc='upper right')

    shade_splits(axes[2])
    axes[2].plot(years, annual['inflow_next30_median'], marker='o', linewidth=1.2, label='Annual median')
    axes[2].plot(years, annual['inflow_next30_q90'], marker='o', linewidth=1.2, label='Annual q90')
    axes[2].plot(years, annual['inflow_next30_q90_roll3'], linewidth=2.2, label='3-year rolling q90')
    axes[2].set_xlabel('Year')
    axes[2].set_ylabel('Next-30 inflow')
    axes[2].grid(True, alpha=0.35)
    axes[2].legend(fontsize='small', loc='upper right')

    plt.tight_layout()
    out_png = out_dir / 'environment_change_diagnostics.png'
    plt.savefig(out_png, dpi=150)
    plt.close()
    print(f"Saved: {out_png}")
    return annual

# Residual quantiles (original scale)
def winsorize(x, p=0.005):
    x = np.asarray(x, dtype=float)
    lo, hi = np.quantile(x[~np.isnan(x)], [p, 1-p])
    return np.clip(x, lo, hi)


def month_to_season(m:int)->str:
    m = int(m)
    if m in (12,1,2):  return 'DJF'
    if m in (3,4,5):   return 'MAM'
    if m in (6,7,8):   return 'JJA'
    return 'SON'

def build_quantile_maps_raw(y_true_raw, y_pred_raw, months, min_n_month=10, min_n_season=20):
    resid = np.asarray(y_true_raw, dtype=float) - np.asarray(y_pred_raw, dtype=float)
    resid_w = winsorize(resid, p=0.01)
    dfq = pd.DataFrame({
        'm': months.values.astype(int),
        'season': months.apply(month_to_season).values,
        'r': resid_w
    })
    g_lo90, g_hi90 = np.quantile(dfq['r'].dropna(), [0.05, 0.95])
    g_lo50, g_hi50 = np.quantile(dfq['r'].dropna(), [0.25, 0.75])
    season_q_90 = (dfq.groupby('season')['r'].quantile([0.05, 0.95]).unstack())
    season_q_50 = (dfq.groupby('season')['r'].quantile([0.25, 0.75]).unstack())
    season_n = dfq.groupby('season')['r'].size()
    month_q_90 = (dfq.groupby('m')['r'].quantile([0.05, 0.95]).unstack())
    month_q_50 = (dfq.groupby('m')['r'].quantile([0.25, 0.75]).unstack())
    month_n = dfq.groupby('m')['r'].size()

    def blend_quantiles(month_q, month_n, season_q, season_n, g_lo, g_hi):
        qlo_map, qhi_map = {}, {}
        for m in sorted(dfq['m'].unique()):
            s = month_to_season(m)
            if m in month_q.index and month_n.get(m, 0) >= min_n_month:
                m_lo, m_hi = float(month_q.loc[m].iloc[0]), float(month_q.loc[m].iloc[1])
                w_m = min(1.0, month_n[m] / 30.0)
            else:
                m_lo, m_hi = np.nan, np.nan
                w_m = 0.0
            if s in season_q.index and season_n.get(s, 0) >= min_n_season:
                s_lo, s_hi = float(season_q.loc[s].iloc[0]), float(season_q.loc[s].iloc[1])
                w_s = 1.0 - w_m
            else:
                s_lo, s_hi = np.nan, np.nan
                w_s = 0.0
            parts_lo, parts_hi, weights = [], [], []
            if w_m > 0 and np.isfinite(m_lo): parts_lo.append(m_lo); parts_hi.append(m_hi); weights.append(w_m)
            if w_s > 0 and np.isfinite(s_lo): parts_lo.append(s_lo); parts_hi.append(s_hi); weights.append(w_s)
            if len(parts_lo) == 0:
                qlo, qhi = g_lo, g_hi
            else:
                w = np.array(weights, dtype=float); w = w / w.sum()
                qlo = float(np.dot(w, np.array(parts_lo)))
                qhi = float(np.dot(w, np.array(parts_hi)))
            qlo_map[int(m)] = qlo
            qhi_map[int(m)] = qhi
        return qlo_map, qhi_map

    qlo90_map, qhi90_map = blend_quantiles(month_q_90, month_n, season_q_90, season_n, g_lo90, g_hi90)
    qlo50_map, qhi50_map = blend_quantiles(month_q_50, month_n, season_q_50, season_n, g_lo50, g_hi50)
    return qlo90_map, qhi90_map, g_lo90, g_hi90, qlo50_map, qhi50_map, g_lo50, g_hi50

def q_for_month(m, q_map, q_global):
    return float(q_map.get(int(m), q_global))

def resolve_first_existing_path(*candidates):
