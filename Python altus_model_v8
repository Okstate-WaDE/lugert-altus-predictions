def permutation_importance_mae_df(model_name, predict_raw_fn, X_i, y_true_raw, feature_names, n_repeats=12, random_state=0):
    X_base = np.asarray(X_i, dtype=float)
    y_true_raw = np.asarray(y_true_raw, dtype=float)
    rng = np.random.default_rng(random_state)

    baseline_pred = np.asarray(predict_raw_fn(X_base), dtype=float)
    baseline_mae = float(mean_absolute_error(y_true_raw, baseline_pred))
    rows = []

    for j, feature in enumerate(feature_names):
        increases = []
        for _ in range(n_repeats):
            X_perm = X_base.copy()
            X_perm[:, j] = rng.permutation(X_perm[:, j])
            perm_pred = np.asarray(predict_raw_fn(X_perm), dtype=float)
            perm_mae = float(mean_absolute_error(y_true_raw, perm_pred))
            increases.append(perm_mae - baseline_mae)

        rows.append({
            'model': model_name,
            'feature': feature,
            'baseline_mae': baseline_mae,
            'mae_increase_mean': float(np.mean(increases)),
            'mae_increase_std': float(np.std(increases, ddof=1)) if len(increases) > 1 else 0.0,
            'n_repeats': int(n_repeats),
        })

    out = pd.DataFrame(rows).sort_values('mae_increase_mean', ascending=False).reset_index(drop=True)
    out['rank'] = np.arange(1, len(out) + 1)
    return out


